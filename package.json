{
  "name": "screenproof",
  "version": "0.5.1",
  "description": "Lint App Store screenshots and app previews against Apple's published dimensions, format, duration, file-size, and count rules. Offline, zero dependencies.",
  "type": "module",
  "bin": {
    "screenproof": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "dist",
    "action.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "test": "node --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck && npm test",
    "prepack": "npm run clean && npm run build"
  },
  "keywords": [
    "ios",
    "app-store",
    "app-store-connect",
    "fastlane",
    "deliver",
    "screenshots",
    "app-previews",
    "video",
    "aso",
    "linter",
    "ci",
    "validation"
  ],
  "author": "TheChosenVictor LLC",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vsolano9/screenproof.git"
  },
  "bugs": {
    "url": "https://github.com/vsolano9/screenproof/issues"
  },
  "homepage": "https://thechosenvictor.com/open-source",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0"
  }
}
